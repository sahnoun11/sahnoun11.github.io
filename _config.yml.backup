markdown: kramdown
kramdown:
  input: GFM
# The Site Configuration

# Import the theme
theme: jekyll-theme-chirpy

# The language of the webpage
lang: en

# Timezone
timezone: Africa/Tunis

# jekyll-seo-tag settings
# ↓ --------------------------

title: Oussama Sahnoun
tagline: Cybersecurity | Red Teaming | Penetration Testing

description: >-
  Cybersecurity blog by Oussama Sahnoun. Focused on penetration testing, red teaming, and threat research, sharing insights, tutorials, and security guides for professionals and enthusiasts.

# Fill in the protocol & hostname for your site.
url: "https://sahnoun11.github.io"

github:
  username: sahnoun11

twitter:
  username: Sahnounoussama5

social:
  name: Sahnoun_Oussama
  email: sahnoun.oussama11@gmail.com
  links:
    - https://x.com/Sahnounoussama5
    - https://github.com/sahnoun11
    - https://www.linkedin.com/in/oussama-sahnoun-0ba565131/

# Site Verification Settings
webmaster_verifications:
  google:
  bing:
  alexa:
  yandex:
  baidu:
  facebook:

# ↑ --------------------------
# The end of `jekyll-seo-tag` settings

# Web Analytics Settings
analytics:
  google:
    id:
  goatcounter:
    id:
  umami:
    id:
    domain:
  matomo:
    id:
    domain:
  cloudflare:
    id:
  fathom:
    id:

# Page views settings
pageviews:
  provider:

# Theme mode
theme_mode:

# CDN for media resources
cdn:

# Avatar
avatar: "https://avatars.githubusercontent.com/u/35012242?v=4"

# Social preview image
social_preview_image: "https://avatars.githubusercontent.com/u/35012242?v=4"

# Table of contents
toc: true

# Comments (disabled for now, can enable later)
comments:
  provider:
  disqus:
    shortname:
  utterances:
    repo:
    issue_term:
  giscus:
    repo:
    repo_id:
    category:
    category_id:
    mapping:
    strict:
    input_position:
    lang:
    reactions_enabled:

# Self-hosted static assets
assets:
  self_host:
    enabled:
    env:

pwa:
  enabled: true
  cache:
    enabled: true
    deny_paths:

paginate: 10

# The base URL of your site
baseurl: ""

# ------------ The following options are not recommended to be modified ------------------

kramdown:
  footnote_backlink: "&#8617;&#xfe0e;"
  syntax_highlighter: rouge
  syntax_highlighter_opts:
    css_class: highlight
    span:
      line_numbers: false
    block:
      line_numbers: true
      start_line: 1

collections:
  tabs:
    output: true
    sort_by: order

defaults:
  - scope:
      path: ""
      type: posts
    values:
      layout: post
      comments: true
      toc: true
      permalink: /posts/:title/
  - scope:
      path: _drafts
    values:
      comments: false
  - scope:
      path: ""
      type: tabs
    values:
      layout: page
      permalink: /:title/

sass:
  style: compressed

compress_html:
  clippings: all
  comments: all
  endings: all
  profile: false
  blanklines: false
  ignore:
    envs: [development]

exclude:
  - "*.gem"
  - "*.gemspec"
  - docs
  - tools
  - README.md
  - LICENSE
  - purgecss.js
  - "*.config.js"
  - "package*.json"

jekyll-archives:
  enabled: [categories, tags]
  layouts:
    category: category
    tag: tag
  permalinks:
    tag: /tags/:name/
    category: /categories/:name/
